{
  "name": "superslop-ai",
  "version": "1.0.0",
  "description": "Interactive installer and Slop-O-Meter auditor for the superslop skills. Super Slop: Maximalist AI Cliché Rules for AI Coding Agents.",
  "type": "module",
  "bin": {
    "superslop-ai": "index.mjs"
  },
  "exports": {
    "./dsh": "./dsh/index.js",
    "./dsh/locale/*.json": "./dsh/locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    }
  },
  "license": "MIT",
  "author": "superslop",
  "keywords": [
    "superslop",
    "ai-slop",
    "design-rules",
    "copy-rules",
    "agent-skills",
    "ui",
    "parody"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0-rc.1 <0.3.0"
  },
  "files": [
    "index.mjs",
    "dsh/",
    "skills/"
  ]
}
